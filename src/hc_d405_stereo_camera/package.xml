<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/ament_package_xml.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hc_d405_stereo_camera</name>
  <version>0.1.0</version>
  <description>Dual Intel RealSense D405 ROS 2 driver and side-by-side VR image publisher.</description>
  <maintainer email="dev@io-ai.tech">io_teleop</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>librealsense2</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
