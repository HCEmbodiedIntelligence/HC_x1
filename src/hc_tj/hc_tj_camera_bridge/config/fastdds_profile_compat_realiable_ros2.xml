<?xml version="1.0" encoding="UTF-8"?>
<dds>
  <profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <!--
      Use UDP only.  TeleBox services and camera/data processes run under
      different users over their lifetime; stale root-owned Fast DDS SHM lock
      files can otherwise leave ROS 2 services discoverable but unresponsive.
      Keep datagrams below the Ethernet MTU for large camera messages.
    -->
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>hc_tj_udp_mtu_safe</transport_id>
        <type>UDPv4</type>
        <sendBufferSize>4194304</sendBufferSize>
        <receiveBufferSize>4194304</receiveBufferSize>
        <maxMessageSize>1400</maxMessageSize>
        <TTL>1</TTL>
        <interfaceWhiteList>
          <address>192.168.2.4</address>
        </interfaceWhiteList>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="hc_tj_udp_only" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>hc_tj_udp_mtu_safe</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>

    <data_writer profile_name="/io_teleop/joint_cmd">
      <topic>
        <historyQos>
          <kind>KEEP_LAST</kind>
          <depth>1</depth>
        </historyQos>
      </topic>
      <qos>
        <durability>
          <kind>VOLATILE</kind>
        </durability>
        <reliability>
          <kind>RELIABLE</kind>
          <max_blocking_time>
            <sec>0</sec>
            <nanosec>1000000</nanosec>
          </max_blocking_time>
        </reliability>
        <disablePositiveAcks>
          <enabled>true</enabled>
          <duration>
            <sec>0</sec>
            <nanosec>1000000</nanosec>
          </duration>
        </disablePositiveAcks>
      </qos>
    </data_writer>
